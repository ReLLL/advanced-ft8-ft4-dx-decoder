set(DX_JS8_QT_PREFIX "${CMAKE_SOURCE_DIR}/build-js8-runtime/install" CACHE PATH "Pinned static Qt Core")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/scripts/stage_js8.py" --verify COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/scripts/stage_js8_payload.py"
 --build "${CMAKE_BINARY_DIR}" --cache "${CMAKE_SOURCE_DIR}/build-js8-runtime" COMMAND_ERROR_IS_FATAL ANY)
list(PREPEND CMAKE_PREFIX_PATH "${DX_JS8_QT_PREFIX}")
find_package(Qt6 6.8 CONFIG REQUIRED COMPONENTS Core PATHS "${DX_JS8_QT_PREFIX}/lib/cmake/Qt6" NO_DEFAULT_PATH)
if(NOT TARGET Qt6::Core)
 message(FATAL_ERROR "Run scripts/build_js8_runtime.py before enabling JS8")
endif()
set(JS8_SOURCE "${CMAKE_SOURCE_DIR}/third_party/js8call")
add_library(dx_js8_upstream STATIC "${JS8_SOURCE}/JS8.cpp" "${JS8_SOURCE}/JS8.hpp"
 "${JS8_SOURCE}/varicode.cpp" "${JS8_SOURCE}/varicode.h" "${JS8_SOURCE}/decodedtext.cpp"
 "${JS8_SOURCE}/jsc.cpp" "${JS8_SOURCE}/jsc_map.cpp" "${JS8_SOURCE}/jsc_list.cpp" src/js8_globals.cpp)
set_target_properties(dx_js8_upstream PROPERTIES AUTOMOC ON CXX_STANDARD 20)
target_include_directories(dx_js8_upstream SYSTEM PUBLIC "${JS8_SOURCE}" /opt/homebrew/include)
target_compile_options(dx_js8_upstream PRIVATE -O2 "-ffile-prefix-map=${CMAKE_SOURCE_DIR}=.")
target_link_libraries(dx_js8_upstream PUBLIC Qt6::Core ${FFTW})
add_library(dx_js8_messages STATIC src/js8_messages.cpp)
target_link_libraries(dx_js8_messages PUBLIC dx_js8_upstream dx_core)
set_target_properties(dx_js8_messages PROPERTIES CXX_STANDARD 20)
add_executable(dx_js8_decoder src/js8_helper.cpp)
target_link_libraries(dx_js8_decoder PRIVATE dx_js8_messages)
set_target_properties(dx_js8_decoder PROPERTIES CXX_STANDARD 20 BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "${HOST_APP}/Contents/Frameworks")
add_custom_command(TARGET dx_js8_decoder POST_BUILD COMMAND install_name_tool -change
 /opt/homebrew/opt/fftw/lib/libfftw3f.3.dylib @rpath/libfftw3f.3.dylib $<TARGET_FILE:dx_js8_decoder>)
if(SANITIZE)
 target_compile_options(dx_js8_upstream PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
 target_link_options(dx_js8_upstream PUBLIC -fsanitize=address,undefined)
endif()
add_executable(dx_js8_message_tests tests/js8_messages.cpp)
target_link_libraries(dx_js8_message_tests PRIVATE dx_js8_messages)
set_target_properties(dx_js8_message_tests PROPERTIES CXX_STANDARD 20 BUILD_RPATH "${HOST_APP}/Contents/Frameworks")
add_test(NAME dx_js8_messages COMMAND dx_js8_message_tests)
add_executable(dx_js8_reference tests/js8_reference.cpp)
target_link_libraries(dx_js8_reference PRIVATE dx_js8_messages)
set_target_properties(dx_js8_reference PROPERTIES CXX_STANDARD 20 BUILD_RPATH "${HOST_APP}/Contents/Frameworks")
add_test(NAME dx_js8_decoder COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_js8_decoder.py" $<TARGET_FILE:dx_js8_decoder> $<TARGET_FILE:dx_js8_reference>)
set_tests_properties(dx_js8_decoder PROPERTIES TIMEOUT 180)
add_executable(dx_js8_pipeline tests/js8_pipeline.cpp)
target_link_libraries(dx_js8_pipeline PRIVATE dx_core)
add_test(NAME dx_js8_pipeline COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_js8_pipeline.py" $<TARGET_FILE:dx_js8_pipeline> $<TARGET_FILE:dx_js8_decoder> $<TARGET_FILE:dx_js8_reference> $<TARGET_FILE:dx_mock>)
set_tests_properties(dx_js8_pipeline PROPERTIES TIMEOUT 90)
